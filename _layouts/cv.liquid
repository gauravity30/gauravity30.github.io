---
layout: default
---
<div class="post">
  <header class="post-header">
    <div class="markdown-cv-actions">
      <a href="{{ page.cv_pdf | escape }}" target="_blank" rel="noopener noreferrer" class="markdown-cv-pdf" aria-label="Download CV PDF">
        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> PDF
      </a>
    </div>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="markdown-cv-content" id="cv-content" data-source="{{ page.cv_source | escape }}" aria-busy="true">
      <p role="status">Loading CV…</p>
      <noscript>Enable JavaScript to load the current CV.</noscript>
    </div>
    <script defer src="{{ '/assets/js/cv-source.js' | relative_url }}"></script>
  </article>
</div>
